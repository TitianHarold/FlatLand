{
  "version": 1,
  "title": "动作与色彩 · 技术示例",
  "description": "用三个几何角色验证移动、转向、变色与登退场。这是一段播放测试，不是色彩革命的正式故事。",
  "example": true,
  "scene": "parade",
  "observer": {"position": [0, -4], "angle": 90},
  "actors": [
    {"id": "square", "name": "正方形", "type": "regular-4", "position": [-3, 0], "color": "#F0C84B"},
    {"id": "triangle", "name": "正三角形", "type": "regular-3", "position": [3, 0], "angle": 180, "color": "#426AB3"},
    {"id": "pentagon", "name": "正五边形", "type": "regular-5", "position": [0, 2], "angle": -90, "color": "#E88970", "visible": false}
  ],
  "acts": [
    {
      "title": "靠近",
      "text": "正方形与三角形各向前移动两身长。它们的形状来自同一个平面世界，路径由剧本指定。",
      "duration": 6,
      "actions": [
        {"at": 1, "actor": "square", "move": [-1, 0], "duration": 4},
        {"at": 1, "actor": "triangle", "move": [1, 0], "duration": 4}
      ]
    },
    {
      "title": "转向与变色",
      "text": "两个角色转向上方。三角形在这一幕开始时换上绿色，五边形随后登场。",
      "duration": 6,
      "actions": [
        {"at": 0, "actor": "square", "turn": 90, "duration": 3},
        {"at": 0, "actor": "triangle", "turn": 90, "color": "#8EBE95", "duration": 3},
        {"at": 3, "actor": "pentagon", "visible": true}
      ]
    },
    {
      "title": "离场与重播",
      "text": "五边形完成一次转身，两位角色依次退场。试试暂停、拖动进度或点击幕列表；从头重播会恢复每个角色的初始状态。",
      "duration": 6,
      "actions": [
        {"at": 0, "actor": "pentagon", "turn": 270, "duration": 4},
        {"at": 4, "actor": "square", "visible": false},
        {"at": 5, "actor": "triangle", "visible": false}
      ]
    }
  ]
}
